# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）
#
# 通过 LLM_PROVIDER 选择提供商：anthropic（默认）或 openai

# 方案 A：Anthropic 官方
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-你的真实密钥
MODEL_ID=claude-sonnet-4-6

# 方案 B：国内 Anthropic 兼容端点（智谱 GLM / Kimi / DeepSeek 等）
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=你的密钥
# MODEL_ID=对应模型名
# ANTHROPIC_BASE_URL=https://你的兼容端点地址

# 方案 C：OpenAI 官方或 OpenAI 兼容端点（DeepSeek / Kimi / 智谱等）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=你的密钥
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_ID=deepseek-chat

# 方案 D：DeepSeek 官方集成（langchain-deepseek，默认关闭 thinking）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=你的密钥
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MODEL_ID=deepseek-flash

# 可选：人物范围 / 最大轮数
# GWI_PERSON_SCOPE=中国历史人物
# GWI_MAX_ROUNDS=10
# GWI_RECENT_PERSONS=10
# GWI_START_MAX_RETRY=3
